# ========================================
# HyperYield Vault Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Network Configuration
# ---------------------
# HyperEVM RPC URL (Hyperliquid)
RPC_URL=https://api.hyperliquid-testnet.xyz/evm

# Alternative mainnet (when available)
# RPC_URL=https://api.hyperliquid.xyz/evm

# Deployment Account
# ------------------
# Private key of the deployer account (0x prefix)
# WARNING: Keep this secure! Use a dedicated deployment wallet
PRIVATE_KEY=your_private_key_here

# Bot Configuration
# -----------------
# Address of the backend bot that will execute rebalances
# If not set, deployer address will be used
BOT_ADDRESS=0x...

# Optional: Separate bot private key for backend operations
BOT_PRIVATE_KEY=your_bot_private_key_here

# Contract Addresses (filled after deployment)
# ---------------------------------------------
ORACLE_ADDRESS=
VAULT_ADDRESS=
MANAGER_ADDRESS=
BASE_ASSET_ADDRESS=0xb88339CB7199b77E23DB6E890353E22632Ba630f  # USDC on HyperEVM
GLUEX_ROUTER_ADDRESS=  # Obtained from GlueX API

# GlueX API Configuration (for backend bot)
# -----------------------------------------
GLUEX_API_KEY=your_gluex_api_key_here
GLUEX_API_URL=https://api.gluex.xyz
GLUEX_ROUTER_URL=https://router.gluex.xyz
GLUEX_YIELDS_URL=https://yield-api.gluex.xyz
GLUEX_CHAIN=hyperevm
UNIQUE_PID=  # Optional: Your unique partner ID

# Bot Operation Settings
# ----------------------
# How often to check for rebalancing opportunities (minutes)
OPTIMIZATION_INTERVAL=30

# How often to update oracle prices (minutes)
ORACLE_UPDATE_INTERVAL=5

# Minimum APY improvement to trigger rebalance (percentage)
MIN_APY_IMPROVEMENT=0.5

# Risk-free rate for Sharpe ratio calculation (decimal, e.g. 0.05 = 5%)
RISK_FREE_RATE=0.05

# Maximum number of vaults to hold in portfolio
MAX_VAULTS=3

# Minimum TVL threshold (USD)
MIN_TVL=100000

# Minimum Sharpe ratio
MIN_SHARPE=0.0

# Deploy fraction (0-1, how much of idle to deploy)
DEPLOY_FRACTION=0.9

# Drift threshold for rebalancing (0-1, e.g. 0.10 = 10%)
DRIFT_THRESHOLD=0.10

# Minimum Sharpe improvement for rebalancing (decimal, e.g. 0.05 = 5%)
MIN_SHARPE_IMPROVEMENT=0.05

# Maximum slippage tolerance (decimal, e.g. 0.02 = 2%)
MAX_SLIPPAGE=0.02

# Rebalancing master switch
REBALANCING_ENABLED=true

# Gas Settings
# ------------
# Gas price in gwei (optional, uses network default if not set)
GAS_PRICE=

# Gas limit multiplier (default 1.2)
GAS_LIMIT_MULTIPLIER=1.2


